# Copie para infra/.env e troque as senhas. O arquivo .env nunca vai para o Git.
POSTGRES_USER=histolente
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=histolente

REDIS_PASSWORD=troque-esta-senha

RABBITMQ_USER=histolente
RABBITMQ_PASSWORD=troque-esta-senha

# Chave do pseudônimo do consentimento (HMAC do e-mail). Gere com: openssl rand -hex 32
SUBJECT_PEPPER=troque-por-uma-chave-aleatoria-longa

# Opcionais
# WEB_PORT=127.0.0.1:3000
# COOKIE_SECURE=true          # obrigatório quando servido por HTTPS
# DOMINIO=189-24-15-186.sslip.io   # perfil publicar-vps (Caddy com HTTPS automático)
# TORCH_THREADS=2                  # igual ao número de vCPUs do servidor
